APP_NAME=code-scanner
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://code-scanner:code-scanner@localhost:5433/code-scanner
REDIS_URL=redis://localhost:6380/0
REDIS_ENABLED=true
PINECONE_API_KEY=
PINECONE_INDEX_NAME=security-guidelines
PINECONE_NAMESPACE=security
PINECONE_HOST=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=microsoft/phi-2
# stub | transformers | hf_inference | groq | openai | routed
LLM_BACKEND=stub
MODEL_ROUTING_POLICY=balanced
MODEL_SPEED_PREFERENCE=balanced
MODEL_QUALITY_GATE=0.7
MODEL_FALLBACK_ORDER=groq,openai,hf_inference,transformers,stub
# Hugging Face token for Inference API: https://huggingface.co/settings/tokens
# Also accepted: HUGGINGFACE_HUB_TOKEN or HUGGINGFACE_API_KEY
HF_TOKEN=
# Optional; default is public HF Inference API host
HF_INFERENCE_BASE_URL=https://api-inference.huggingface.co
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
RISK_THRESHOLD=0.35
MAX_LLM_CHUNKS=20
MAX_CONCURRENCY=4
SCAN_MODE=local_only

# Optional: debugpy attach (scripts/run_with_debugpy.py)
# DEBUGPY_HOST=127.0.0.1
# DEBUGPY_PORT=5678
